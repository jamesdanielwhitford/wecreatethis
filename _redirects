# Blog is now the homepage: clean URLs for both sections and posts
# (/{section...}/{post-slug} is a real path, resolved client-side by app.js -
# no server routing needed per post). Real files must pass through first
# (first match wins), then any other path serves the section/post shell.
# Nested sections and posts at any depth work with no extra rules: adding a
# content folder needs NO changes here.
/  /  200
/content/*  /content/:splat  200
/app.js  /app.js  200
/icons.js  /icons.js  200
