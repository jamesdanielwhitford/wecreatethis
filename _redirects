# Cloudflare Pages / Netlify redirects

# Domain-wide redirect from old domain to new domain
https://wecreatethis.pages.dev/* https://wecreatethis.com/:splat 301

# Client-side routing support for sub-apps

# Invisible Ink - serve index.html for all invisibleink routes
/invisibleink/*  /invisibleink/index.html  200

# Tarot app routing (if needed in future)
/tarot/*  /tarot/index.html  200

# Birdle app routing (if needed in future)
/birdle/*  /birdle/index.html  200

# Blog is now the homepage: clean URLs for both sections and posts
# (/{section...}/{post-slug} is a real path, resolved client-side by app.js -
# no server routing needed per post). Real files must pass through first
# (first match wins), then any other path serves the section/post shell.
# Nested sections and posts at any depth work with no extra rules: adding a
# content folder needs NO changes here.
/  /  200
/content/*  /content/:splat  200
/app.js  /app.js  200
/icons.js  /icons.js  200
/sw-toast.js  /sw-toast.js  200
/style.css  /style.css  200
/sw.js  /sw.js  200
/manifest.json  /manifest.json  200
/content-manifest.json  /content-manifest.json  200
/sitemap.xml  /sitemap.xml  200
/robots.txt  /robots.txt  200
/llms.txt  /llms.txt  200
/icon-192.png  /icon-192.png  200
/icon-512.png  /icon-512.png  200
/favicon.svg  /favicon.svg  200
/profile.jpeg  /profile.jpeg  200
/apple-touch-icon.png  /apple-touch-icon.png  200
/og-image.png  /og-image.png  200
/fonts/*  /fonts/:splat  200
/archive/*  /archive/:splat  200
/*  /section  200
